@page
@model LandingPage.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}

@section Head {

}
<!-- Hero -->
<header id="home" class="hero-cover">
    <!-- تصویر پس‌زمینه (خودت مسیر را عوض کن) -->
    <div class="hero-bg" style="background-image: url('assets/banner1.jpg');"></div>

    <!-- لایه برای خوانایی متن -->
    <div class="hero-overlay"></div>

    <div class="container hero-inner">
        <div class="hero-panel fade-up">
            <h1 class="display-6 fw-extrabold lh-base mb-3 text-primary">
                کتابخانه دیجیتال سیره نبوی <span>(14 جلد)</span>
            </h1>

            <p class="mb-4">
                دسترسی آنلاین به مجموعه 14 جلدی سیره نبوی؛ از زمینه‌های تاریخی پیش از ولادت پیامبر اسلام
                (تا حدود یک قرن قبل)، تا وقایع پس از رحلت، از جمله شهادت حضرت فاطمه زهرا (س) و رویداد سقیفه.
            </p>

            <div class="d-flex gap-2 flex-wrap">
                <a href="#about" class="btn btn-primary btn-lg">معرفی کتاب</a>
                <a href="#author-info" class="btn btn-primary btn-lg">روایتگران امانت‌دار</a>
                <a href="#jelda" class="btn btn-primary btn-lg">جلدهای مجموعه</a>
                <a href="#online-version" class="btn btn-outline-light btn-lg">کتابخانه دیجیتال و هوشمند</a>
                <a href="#join" class="btn btn-outline-light btn-lg">عضویت و شروع مطالعه</a>
            </div>
        </div>
    </div>
</header>

<!-- About -->
<section class="about-section" id="about">
    <!-- سکشن اول: معرفی کتاب -->
    <section id="about-book" class="section-block">
        <div class="container">
            <div class="content-side">
                <h2>درباره مجموعه «روزشمار سیره نبوی»</h2>
                <p>این اثر 14 جلدی، دقیق‌ترین تلاش پژوهشی برای ترسیم روزبه‌روزِ حیات پیامبر (ص) است. برخلاف روایت‌های پراکنده، اینجا تاریخ با رعایت توالی زمانی و نقد علمی منابع کهن بازسازی شده است.</p>
                <div class="feature-list">
                    <div class="card">
                        <strong>14 مجلد نفیس</strong>
                        شامل بیش از هزاران صفحه تحقیق مستند از عصر مکه تا مدینه.
                    </div>
                    <div class="card">
                        <strong>تحلیل انتقادی</strong>
                        رفع تضادهای موجود در منابعی چون تاریخ طبری و سیره ابن‌اسحاق.
                    </div>
                    <div class="card">
                        <strong>گاه‌شمار دقیق</strong>
                        تنظیم رخدادها بر اساس میانگین سن و محاسبات تاریخی نوآورانه.
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- سکشن دوم: نویسنده و تیم -->
    <section id="author-info" class="section-block">
        <div class="container">
            <div class="image-side">
                <img src="~/assets/dr_zargar1.png" class="img-fluid" style="border-radius: 50%;" alt="دکتر زرگری نژاد">
            </div>
            <div class="content-side">
                <h2>روایتگران امانت‌دار</h2>
                <p>این مجموعه با قلم استاد <strong>غلامحسین زرگری‌نژاد</strong></p>
                <img src="~/assets/dr_zargar1.png" class="img-side-inline img-fluid" alt="دکتر زرگری نژاد">
                <p> و همکاری تیمی متشکل از ده‌ها پژوهشگر دکتری تاریخ اسلام به ثمر رسیده است.</p>
                <div class="feature-list">
                    <div class="card">
                        <strong>نظارت علمی</strong>
                        تطبیق دقیق ارجاعات توسط اساتید برجسته تاریخ.
                    </div>
                    <div class="card">
                        <strong>تیم اجرایی</strong>
                        بیش از ۲۰ متخصص در حوزه‌های ویراستاری، اعراب‌گذاری و نرم‌افزار.
                    </div>
                    <div class="card">
                        <strong>امانتداری تاریخی</strong>
                        تعهد کامل به استناد بر منابع دست اول قرن‌های اولیه هجری.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- سکشن سوم: نسخه آنلاین (بر اساس فایل PDF) -->
    <section id="online-version" class="section-block">
        <div class="container">
            <div class="content-side">
                <h2>کتابخانه دیجیتال و هوشمند</h2>
                <p>نسخه آنلاین، تنها یک نمایشگر ساده نیست؛ بلکه یک دستیار پژوهشی قدرتمند برای محققان و علاقمندان است.</p>
                <img src="~/assets/online-book-1.png" class="img-side-inline img-fluid" alt="نسخه آنلاین">
                <div class="feature-list">
                    <div class="card">
                        <strong>Reader دوحالته</strong>
                        مطالعه در حالت تصویری (مطابق چاپ) یا متنی (HTML) با قابلیت زوم.
                    </div>
                    <div class="card">
                        <strong>جستجوی معنایی</strong>
                        جستجوی عبارتی دقیق در تمام 14 جلد و نمایش آنی جلد و صفحه.
                    </div>
                    <div class="card">
                        <strong>میز کار پژوهشی</strong>
                        قابلیت هایلایت، نشانه‌گذاری (Bookmark) و فیش‌برداری دیجیتال.
                    </div>
                    <div class="card">
                        <strong>اشتراک منعطف</strong>
                        دسترسی از طریق خرید دوره کامل یا اشتراک‌های ماهانه و سالانه.
                    </div>
                </div>
                <a href="#" class="btn-cta">ورود به کتابخانه آنلاین</a>
            </div>
            <div class="image-side">
                <img src="~/assets/online-book-1.png" class="img-fluid" alt="نسخه آنلاین">
            </div>
        </div>
    </section>

</section>

