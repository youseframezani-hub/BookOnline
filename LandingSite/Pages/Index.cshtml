<!-- Join / Real Form --><section id="join" class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="p-4 p-md-5 rounded-4 shadow form-box bg-white">
                    <h2 class="fw-bold text-center mb-2">ثبت‌نام برای دسترسی آنلاین</h2>
                    <p class="text-secondary text-center mb-4">
                        فرم زیر را تکمیل کنید؛ پس از ثبت، پیام تایید برای شما نمایش داده می‌شود.
                    </p>

                    @if (TempData["SignupSuccess"] != null)
                    {
                        <div class="alert alert-success text-center">
                            @TempData["SignupSuccess"]
                        </div>
                    }

                    @if (TempData["SignupError"] != null)
                    {
                        <div class="alert alert-danger text-center">
                            @TempData["SignupError"]
                        </div>
                    }

                    <form method="post" asp-antiforgery="true">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UserRegistration.FullName" class="form-label"></label>
                                <input asp-for="UserRegistration.FullName" class="form-control" />
                                <span asp-validation-for="UserRegistration.FullName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserRegistration.Email" class="form-label"></label>
                                <input asp-for="UserRegistration.Email" type="email" class="form-control" />
                                <span asp-validation-for="UserRegistration.Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserRegistration.Mobile" class="form-label"></label>
                                <input asp-for="UserRegistration.Mobile" type="tel" class="form-control" placeholder="09xxxxxxxxx" />
                                <span asp-validation-for="UserRegistration.Mobile" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UserRegistration.Role" class="form-label"></label>
                                <select asp-for="UserRegistration.Role" class="form-select">
                                    <option value="">انتخاب کنید...</option>
                                    <option value="پژوهشگر">پژوهشگر</option>
                                    <option value="دانشجو">دانشجو</option>
                                    <option value="طلبه">طلبه</option>
                                    <option value="سایر">سایر</option>
                                </select>
                                <span asp-validation-for="UserRegistration.Role" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="UserRegistration.Password" class="form-label"></label>
                                <input asp-for="UserRegistration.Password" type="password" class="form-control" />
                                <span asp-validation-for="UserRegistration.Password" class="text-danger"></span>
                            </div>
                            <div class="col-12 form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="terms" required>
                                <label class="form-check-label" for="terms">قوانین و شرایط استفاده را می‌پذیرم.</label>
                            </div>
                            <div class="col-12 d-grid mt-3">
                                <button class="btn btn-primary btn-lg" type="submit">ثبت‌نام</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>



@section Scripts {

    <script src="~/lib/bootstrap/dist/js/land-page.js?v=1"></script>

    <script>
        // تابع جاوااسکریپت برای حرکت اسلایدر
        function scrollSlider(direction) {
            const slider = document.getElementById('bookSlider');
            slider.scrollBy({
                left: direction,
                behavior: 'smooth'
            });
        }
    </script>

}