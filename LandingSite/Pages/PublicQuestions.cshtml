@page
@model LandingPage.Pages.PublicQuestionsModel
@{
    ViewData["Title"] = "پرسش‌های عمومی | کتابخانه دیجیتال سیره نبوی";
    ViewData["Description"] = "نمایش پرسش‌ها و پاسخ‌های منتشرشده توسط تیم ادمین کتابخانه آنلاین ۱۴ جلدی سیره نبوی";
}
@section Head {
    <style>
        .hero-faq {
            background: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), url('../assets/banner-farsi.png') center/cover no-repeat;
            position: relative;
            min-height: 400px;
        }

        .accordion-button span.badge {
            font-size: 0.75rem;
        }

        .hero-faq p.text-muted, h1,h6 {
            color:#fff !important;
        }

        .card{
            background: #fcf9f27a;
            border: 1px solid rgb(47 78 45 / 24%) !important;
        }

        .btn-outline-primary {
            --bs-btn-color: #198754;
            --bs-btn-border-color: #198754;
        }

        .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
            color: var(--bs-nav-pills-link-active-color);
            background-color: #198754;
        }

        .nav-link {
            color: #198754;
        }

        .btn:hover{
            background-color: #24be77;
            border-color: #059d56;
        }
    </style>
}
<section class="py-5 hero-faq">
    <div class="container">
        <div class="row align-items-center gy-4">
            <div class="col-lg-7">
                <p class="badge bg-light text-primary small mb-3">دانشنامه آنلاین کاربران</p>
                <h1 class="fw-bold mb-3">پرسش‌های عمومی</h1>
                <p class="lead text-muted">
                    مجموعه‌ای از پرسش‌های تاییدشده توسط ادمین‌های کتابخانه دیجیتال سیره نبوی
                    که پس از پالایش، برای استفاده پژوهشگران منتشر شده‌اند. برای ارسال پرسش
                    جدید از صفحه <a href="~/Contact" class="link-primary fw-semibold">تماس با ما</a> اقدام کنید.
                </p>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase small mb-2">آخرین بروزرسانی</h6>
                        <h6 class="mb-1 fw-semibold">@Model.LastUpdatedHumanized</h6>
                        <p class="text-muted small mb-0">
                            پاسخ‌ها به صورت ادواری و بر اساس بازخورد پژوهشگران به‌روزرسانی می‌شوند.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pb-5 pt-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase small mb-3">دسته‌بندی‌ها</h6>
                        <div class="nav flex-column nav-pills gap-2" role="tablist">
                            <a class="nav-link @(Model.CategoryFilter == null ? "active" : "")"
                               asp-page="./PublicQuestions">
                                همه پرسش‌ها
                            </a>
                            @foreach (var category in Model.Categories)
                            {
                                <a class="nav-link @(Model.CategoryFilter == category ? "active" : "")"
                                   asp-page="./PublicQuestions"
                                   asp-route-category="@category">
                                    @category
                                </a>
                            }
                        </div>
                        <hr class="my-4" />
                        <p class="text-muted small mb-2">
                            پرسش شما در این فهرست نیست؟
                        </p>
                        <a class="btn btn-outline-primary w-100" href="~/Contact">
                            ارسال پرسش جدید
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-9">
                @if (!Model.Items.Any())
                {
                    <div class="alert alert-info" role="alert">
                        هنوز پرسشی در این دسته‌بندی منتشر نشده است. لطفاً دسته دیگری را انتخاب کنید.
                    </div>
                }
                else
                {
                    <div class="accordion shadow-sm border-0" id="faqAccordion">
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            var item = Model.Items[i];
                            var accordionId = $"faq-{i}";
                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-@accordionId">
                                    <button class="accordion-button @(i == 0 ? "" : "collapsed")" type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse-@accordionId"
                                            aria-expanded="@(i == 0 ? "true" : "false")"
                                            aria-controls="collapse-@accordionId">
                                        <span class="me-2 badge bg-primary-subtle text-primary">@item.Category</span>
                                        <span>@item.Question</span>
                                    </button>
                                </h2>
                                <div id="collapse-@accordionId"
                                     class="accordion-collapse collapse @(i == 0 ? "show" : "")"
                                     aria-labelledby="heading-@accordionId"
                                     data-bs-parent="#faqAccordion">
                                    <div class="accordion-body">
                                        <p>@item.Answer</p>
                                        <p class="text-muted small mb-0">
                                            آخرین به‌روزرسانی: @item.UpdatedOn.ToString("yyyy/MM/dd")
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>
